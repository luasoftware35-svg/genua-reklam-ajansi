{
  "functions": {
    "api/blog-post.js": {
      "includeFiles": "{blog-detay.html,lib/blog-detay-template.html,lib/blog.js}"
    },
    "api/sitemap.js": {
      "includeFiles": "lib/blog.js"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/anasayfa",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/anasayfa",
      "permanent": true
    },
    {
      "source": "/denizli-reklam-ajansi.html",
      "destination": "/denizli-reklam-ajansi",
      "permanent": true
    },
    {
      "source": "/hakkimizda.html",
      "destination": "/hakkimizda",
      "permanent": true
    },
    {
      "source": "/hizmetler.html",
      "destination": "/hizmetler",
      "permanent": true
    },
    {
      "source": "/blog-denizli-reklam-ajansi.html",
      "destination": "/blog-denizli-reklam-ajansi",
      "permanent": true
    },
    {
      "source": "/blog-detay.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[a-z0-9-]+)"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog-detay",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[a-z0-9-]+)"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog-detay.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog-detay",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/anasayfa",
      "destination": "/anasayfa.html"
    },
    {
      "source": "/denizli-reklam-ajansi",
      "destination": "/denizli-reklam-ajansi.html"
    },
    {
      "source": "/hakkimizda",
      "destination": "/hakkimizda.html"
    },
    {
      "source": "/hizmetler",
      "destination": "/hizmetler.html"
    },
    {
      "source": "/dijital-reklam",
      "destination": "/dijital-reklam.html"
    },
    {
      "source": "/sosyal-medya",
      "destination": "/sosyal-medya.html"
    },
    {
      "source": "/marka-tasarim",
      "destination": "/marka-tasarim.html"
    },
    {
      "source": "/icerik-uretimi",
      "destination": "/icerik-uretimi.html"
    },
    {
      "source": "/seo",
      "destination": "/seo.html"
    },
    {
      "source": "/web-tasarim",
      "destination": "/web-tasarim.html"
    },
    {
      "source": "/projelerimiz",
      "destination": "/projelerimiz.html"
    },
    {
      "source": "/portfolyo",
      "destination": "/portfolyo.html"
    },
    {
      "source": "/vaka-analizi",
      "destination": "/vaka-analizi.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-post"
    },
    {
      "source": "/blog-denizli-reklam-ajansi",
      "destination": "/blog-denizli-reklam-ajansi.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/iletisim",
      "destination": "/iletisim.html"
    },
    {
      "source": "/teklif-al",
      "destination": "/teklif-al.html"
    },
    {
      "source": "/gizlilik-politikasi",
      "destination": "/gizlilik-politikasi.html"
    },
    {
      "source": "/api/chat",
      "destination": "https://genua-admin.vercel.app/api/chat"
    },
    {
      "source": "/api/reel-meta",
      "destination": "https://genua-admin.vercel.app/api/reel-meta"
    },
    {
      "source": "/api/reel-thumb",
      "destination": "https://genua-admin.vercel.app/api/reel-thumb"
    },
    {
      "source": "/api/behance-meta",
      "destination": "https://genua-admin.vercel.app/api/behance-meta"
    },
    {
      "source": "/api/forms/:path*",
      "destination": "https://genua-admin.vercel.app/api/forms/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://genua-admin.vercel.app/api/admin/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://genua-admin.vercel.app/_next/:path*"
    },
    {
      "source": "/admin",
      "destination": "https://genua-admin.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://genua-admin.vercel.app/admin/:path*"
    }
  ]
}
